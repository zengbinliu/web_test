# Preferred: one SQLAlchemy URL. Leave blank to use the DB_* settings below.
DATABASE_URL=

# Default MySQL configuration (backward compatible).
DB_DIALECT=mysql+mysqlconnector
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-with-your-password
DB_NAME=replace-with-your-database
DB_SCHEMA=

# Optional relation hints for columns without conventional foreign-key names.
RELATION_HINTS_JSON={}

# OpenAI-compatible LLM configuration. LLM_API_URL accepts either an API base
# URL ending in /v1 or the complete endpoint ending in /chat/completions.
LLM_API_KEY=replace-with-your-api-key
LLM_API_URL=https://your-api-host.example/v1
LLM_MODEL=gpt-5.6-sol
LLM_REASONING_EFFORT=none
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
# Optional. Leave blank for GPT-5.6 unless your provider documents support.
LLM_TEMPERATURE=

# Shared graph and application settings.
TABLE_GRAPH_PATH=table_graph.json
SCHEMA_CATALOG_MAX_CHARS=60000
MAX_SELECT_ROWS=100
AUTO_DEPENDENCY_MAX_ROWS=100
# Hierarchical insert plans. Total rows are the sum of every expanded entity level.
DATA_PLAN_MAX_ENTITIES=20
DATA_PLAN_MAX_PER_PARENT=1000
DATA_PLAN_MAX_ROWS=2000
APP_HOST=127.0.0.1
APP_PORT=8000
FLASK_DEBUG=0
CONFIRMATION_SECRET=replace-with-a-long-random-secret
CONFIRMATION_MAX_AGE_SECONDS=300
