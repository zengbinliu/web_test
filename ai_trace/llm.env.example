# AI_TRACE_CHAIN_WINDOW_SECONDS=30
# AI_TRACE_CHAIN_NEIGHBOR_COUNT=8
# AI_TRACE_MAX_EVENTS_FOR_LLM=80
# AI_TRACE_LLM_TIMEOUT=60
