# 复制为 llm.env 后填写真实值（不要提交密钥）
AI_TRACE_LLM_API_KEY=your_openai_compatible_api_key
AI_TRACE_LLM_API_BASE=https://api.openai.com/v1
AI_TRACE_LLM_MODEL=gpt-4o-mini

# 可选：覆盖检测与事件链参数
