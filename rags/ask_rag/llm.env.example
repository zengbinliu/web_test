# =============================================================================
# Cursor User API Key — Cloud Agents API（Bearer 认证）
# =============================================================================
# 文档：https://cursor.com/cn/docs/api
# 创建路径：Dashboard → API Keys → User API Keys
#   https://cursor.com/dashboard/api?section=user-keys#user-api-keys
# 密钥格式：crsr_xxxxxxxx（创建后仅显示一次，请妥善保存）
# 验证接口：GET https://api.cursor.com/v1/me
# =============================================================================
CURSOR_API_KEY=your_cursor_api_key

# =============================================================================
# askreolink RAG LLM 生成层
# =============================================================================
# provider=cursor：通过 Cloud Agents API v1 创建无仓库 Agent 生成回答
# provider=openai：OpenAI 兼容 chat/completions（更快，见下方注释块）
REOLINK_RAG_LLM_PROVIDER=cursor

# 推荐 auto（First-party 模型池）；显式 composer-2.5 等走 API 池
REOLINK_RAG_LLM_MODEL=auto

# Cloud Agent 轮询与超时（秒；超时范围 10–600）
REOLINK_RAG_CURSOR_POLL_INTERVAL=2
REOLINK_RAG_CURSOR_TIMEOUT=180

# API 基址（一般无需修改）
# REOLINK_RAG_CURSOR_API_BASE=https://api.cursor.com/v1

# 前置条件：Cloud Agents 需在 Dashboard 设置 Spend Limit（至少 $2 可用额度）
# 设置路径：https://cursor.com/dashboard?tab=settings

# =============================================================================
# 备选：OpenAI 兼容 API
# =============================================================================
# REOLINK_RAG_LLM_PROVIDER=openai
# REOLINK_RAG_LLM_API_KEY=sk-...
# REOLINK_RAG_LLM_API_BASE=https://api.openai.com/v1
# REOLINK_RAG_LLM_MODEL=gpt-4o-mini

# =============================================================================
# 爬取截图视觉分析专用（不影响 askreolink 问答 LLM）
# =============================================================================
# REOLINK_CRAWL_VISION_API_KEY=sk-...
# REOLINK_CRAWL_VISION_API_BASE=https://api.openai.com/v1
# REOLINK_CRAWL_VISION_MODEL=gpt-4o-mini
