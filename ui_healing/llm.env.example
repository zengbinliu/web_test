# =============================================================================
# UI 元素自愈全部配置模板（复制为 llm.env 并填写）
# 由 llm_config.load_llm_env 加载；进程已有同名环境变量不会被覆盖
# =============================================================================

# --- LLM 连接（Agently OpenAICompatible）---
REOLINK_RAG_LLM_PROVIDER=openai
REOLINK_RAG_LLM_API_KEY=sk-your-api-key
REOLINK_RAG_LLM_API_BASE=https://web-sub2api.reolink.dev/v1
REOLINK_RAG_LLM_MODEL=gpt-5.6-terra-medium

CLOUD_HEALING_LLM_PROVIDER=openai
CLOUD_HEALING_API_KEY=sk-your-api-key
CLOUD_HEALING_API_BASE=https://web-sub2api.reolink.dev/v1
CLOUD_HEALING_MODEL=gpt-5.6-terra-medium

# --- Agently 双模型 ---
CLOUD_HEALING_FINDER_MODEL=gpt-5.6-terra-medium
CLOUD_HEALING_VERIFIER_MODEL=gpt-5.6-luna-medium

# --- 自愈行为开关与限额 ---
CLOUD_HEALING_ENABLED=0
CLOUD_HEALING_PERSIST=1
CLOUD_HEALING_MAX_PER_RUN=10
CLOUD_HEALING_API_TIMEOUT_S=60
CLOUD_HEALING_DOM_MAX_CHARS=24000
CLOUD_HEALING_MAX_CANDIDATES=3
CLOUD_HEALING_TESTCASE_ID=
